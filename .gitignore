# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependency directories
node_modules/

# Build output
dist/
dist-ssr/
build/
.vite/
vite.config.ts.timestamp-*

# Local environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Cache
.cache/
*.tsbuildinfo

# Local serverless / firebase emulators
.firebase/
.vercel/
.netlify/
tmp/
coverage/
