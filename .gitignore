# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# OS specific files
ehthumbs.db
Desktop.ini

# Test outputs
coverage/
*.lcov

# ESLint / TypeScript caches
.eslintcache
.tscache/

# Optional lockfiles (uncomment if you prefer)
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# Local preview / dev data
*.local
